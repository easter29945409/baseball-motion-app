<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    android:background="#1E293B"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 頂部資料行 (打者資訊標籤 + 時間戳記 + 刪除按鈕 🗑️) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvItemPlayerBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#334155"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="👤 #18 王大明 (175cm / 右打)"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="2026-09-24 10:15:30"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnItemDelete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#EF4444"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="🗑️"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 數據數值欄位 (4 欄平分展示) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="初速/揮棒速"
                android:textColor="#CBD5E1"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvItemSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="142.5 km/h"
                android:textColor="#00E5FF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="出球仰角"
                android:textColor="#CBD5E1"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvItemAngle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24.1°"
                android:textColor="#FFEA00"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="估算距離"
                android:textColor="#CBD5E1"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvItemDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="98.5 m"
                android:textColor="#00E676"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="軀幹角速度"
                android:textColor="#CBD5E1"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvItemAngularVelocity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="720 deg/s"
                android:textColor="#E040FB"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
